    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Weather widget shows the weather where you are. Your location is rounded to about 10 km first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget Tiempo muestra el tiempo donde estás. Tu ubicación se redondea primero a unos 10 km."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget Clima muestra el clima donde estás. Tu ubicación se redondea primero a unos 10 km."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le widget Météo affiche la météo là où vous êtes. Votre position est d’abord arrondie à environ 10 km."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava Durumu widget'ı bulunduğunuz yerin havasını gösterir. Konumunuz önce yaklaşık 10 km'ye yuvarlanır."
          }
        }
      }
    },
