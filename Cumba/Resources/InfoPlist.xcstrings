    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The To-dos widget shows your reminders and lets you tick them off and add new ones. Nothing leaves your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget Pendientes muestra tus recordatorios y te permite marcarlos y añadir otros nuevos. Nada sale de tu Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget Pendientes muestra tus recordatorios y te permite marcarlos y agregar otros nuevos. Nada sale de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le widget À faire affiche vos rappels et vous permet de les cocher et d’en ajouter de nouveaux. Rien ne quitte votre Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapılacaklar widget'ı anımsatıcılarınızı gösterir; onları işaretleyip yenilerini eklemenizi sağlar. Hiçbir şey Mac'inizden çıkmaz."
          }
        }
      }
    },
