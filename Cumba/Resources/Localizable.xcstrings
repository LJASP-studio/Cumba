    },
    "Cumba asks for a permission only when you use the feature that needs it. Everything here can be changed again in System Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba solo pide un permiso cuando usas la función que lo necesita. Todo lo que hay aquí se puede volver a cambiar en Ajustes del Sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba solo pide un permiso cuando usas la función que lo necesita. Todo lo que hay aquí se puede volver a cambiar en Configuración del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba ne demande une autorisation que lorsque vous utilisez la fonction qui en a besoin. Vous pourrez toujours modifier ces choix dans Réglages Système."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba bir izni yalnızca onu gerektiren özelliği kullandığınızda ister. Buradaki her şeyi daha sonra Sistem Ayarları'ndan değiştirebilirsiniz."
          }
        }
      }
    },
    "Cumba is up to date." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba está actualizado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba está actualizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba est à jour."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba güncel."
          }
        }
      }
    },
    "Cumba may not control %@. Allow it in System Settings > Privacy & Security > Automation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba no tiene permiso para controlar %@. Permítelo en Ajustes del Sistema > Privacidad y seguridad > Automatización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba no tiene permiso para controlar %@. Permítelo en Configuración del Sistema > Privacidad y seguridad > Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba n’est pas autorisé à contrôler %@. Autorisez-le dans Réglages Système > Confidentialité et sécurité > Automatisation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba'nın %@ uygulamasını denetleme izni yok. Sistem Ayarları > Gizlilik ve Güvenlik > Otomasyon'dan izin verin."
          }
        }
      }
    },
    "Cumba needs your approval in System Settings to launch at login." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba necesita tu aprobación en Ajustes del Sistema para abrirse al iniciar sesión."
          }
        },
        "es-419" : {
          "stringUnit" : {
