    },
    "What Claude Code and Codex are doing, and their permission requests" : {
      "comment" : "Widget description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hacen Claude Code y Codex, y sus solicitudes de permiso"
