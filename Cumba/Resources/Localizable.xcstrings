    "It closes when you move away. Change the delay or switch to click-only in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cierra cuando alejas el puntero. En Ajustes puedes cambiar el retraso o hacer que solo se abra con un clic."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cierra cuando alejas el puntero. En Configuración puedes cambiar el retraso o hacer que solo se abra con un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se ferme quand vous éloignez le pointeur. Dans les réglages, vous pouvez changer le délai ou l’ouvrir uniquement d’un clic."
