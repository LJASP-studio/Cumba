    "Weather" : {
      "comment" : "Widget name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clima"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Météo"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava Durumu"
          }
        }
      }
    },
    "Weather data comes from Open-Meteo. Your location is rounded to about 10 km before it's sent, and Apple Maps finds the city name. For a chosen city, only its coordinates are sent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del tiempo proceden de Open-Meteo. Tu ubicación se redondea a unos 10 km antes de enviarse, y Mapas de Apple obtiene el nombre de la ciudad. Si eliges una ciudad, solo se envían sus coordenadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del clima vienen de Open-Meteo. Tu ubicación se redondea a unos 10 km antes de enviarse, y Mapas de Apple obtiene el nombre de la ciudad. Si eliges una ciudad, solo se envían sus coordenadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données météo proviennent d’Open-Meteo. Votre position est arrondie à environ 10 km avant d’être envoyée, et Plans trouve le nom de la ville. Pour une ville choisie, seules ses coordonnées sont envoyées."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava durumu verileri Open-Meteo'dan gelir. Konumunuz gönderilmeden önce yaklaşık 10 km'ye yuvarlanır, şehir adını Apple Haritalar bulur. Seçtiğiniz bir şehir için yalnızca onun koordinatları gönderilir."
          }
        }
      }
    },
    "Weather is unavailable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay información del tiempo disponible."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clima no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Météo indisponible."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava durumu alınamadı."
          }
        }
      }
    },
    "Weather widget: the weather where you are, rounded to about 10 km" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget Tiempo: el tiempo donde estás, con la ubicación redondeada a unos 10 km"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
