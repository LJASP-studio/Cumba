    "Allow in the notch is the same as Allow in Claude Code: the tool runs right away. Requests with hidden characters never get an Allow button." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Permitir» en la muesca equivale a «Permitir» en Claude Code: la herramienta se ejecuta al momento. Las solicitudes con caracteres ocultos nunca muestran el botón «Permitir»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Permitir” en la muesca equivale a “Permitir” en Claude Code: la herramienta se ejecuta de inmediato. Las solicitudes con caracteres ocultos nunca muestran el botón “Permitir”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir « Autoriser » dans l’encoche revient à choisir « Autoriser » dans Claude Code : l’outil s’exécute immédiatement. Les demandes contenant des caractères invisibles n’affichent jamais le bouton « Autoriser »."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notch'taki İzin Ver, Claude Code'daki İzin Ver ile aynıdır: araç hemen çalışır. Gizli karakter içeren isteklerde İzin Ver düğmesi hiç gösterilmez."
          }
        }
      }
    },
