    "With no notch at all, for example with the lid closed, the main display gets one." : {
      "comment" : "Help for a setting",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay ninguna muesca, por ejemplo con la tapa cerrada, la pantalla principal muestra una."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay ninguna muesca, por ejemplo con la tapa cerrada, la pantalla principal muestra una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il n’y a aucune encoche, par exemple en mode écran fermé, l’écran principal en affiche une."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç notch yoksa, örneğin kapak kapalıyken, ana ekranda bir tane gösterilir."
          }
        }
      }
    },
