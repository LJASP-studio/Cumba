    "Codex runs new hooks only after you trust them: after installing, run /hooks in Codex once and trust Cumba's hooks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex solo ejecuta hooks nuevos cuando confías en ellos: tras instalarlos, ejecuta /hooks una vez en Codex y confía en los hooks de Cumba."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex solo ejecuta hooks nuevos si confías en ellos: después de instalarlos, ejecuta /hooks una vez en Codex y confía en los hooks de Cumba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex n’exécute les nouveaux hooks que si vous les avez approuvés : après l’installation, lancez une fois /hooks dans Codex et approuvez les hooks de Cumba."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex yeni hook'ları ancak onlara güvendiğinizde çalıştırır: kurduktan sonra Codex'te bir kez /hooks komutunu çalıştırıp Cumba'nın hook'larına güvenin."
          }
        }
      }
    },
